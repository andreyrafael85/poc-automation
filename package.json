{
  "name": "poc-automation",
  "version": "3.7.9",
  "description": "PoC Automation 3.0 — the all-in-one Dynatrace app to run a proof of concept end to end, every number traceable to its query",
  "scripts": {
    "build": "dt-app build",
    "start": "dt-app dev",
    "create:function": "dt-app function create",
    "create:action": "dt-app action create",
    "uninstall": "dt-app uninstall",
    "deploy": "dt-app deploy",
    "update": "dt-app update",
    "info": "dt-app info",
    "help": "dt-app help",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p ui/tsconfig.json && tsc --noEmit -p actions/tsconfig.action.json && tsc --noEmit -p actions/tsconfig.widget.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "analyze": "dt-app analyze",
    "verify": "npm run typecheck && npm run lint && npm run test && node scripts/scan-untranslated.mjs && npm run release:check && npm run build -- --optimize --enable-code-splitting",
    "docs:catalog": "node scripts/generate-query-catalog-doc.mjs",
    "build:delivery": "dt-app build --optimize --enable-code-splitting",
    "release:check": "node scripts/release.mjs --check",
    "release:pack": "node scripts/release.mjs --pack",
    "release": "node scripts/release.mjs",
    "brand:status": "node scripts/brand-pack.mjs status",
    "brand:install": "node scripts/brand-pack.mjs install",
    "brand:strip": "node scripts/brand-pack.mjs strip"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@dynatrace-sdk/app-environment": "^1.1.4",
    "@dynatrace-sdk/automation-action-utils": "^0.43.1",
    "@dynatrace-sdk/client-document": "^1.34.0",
    "@dynatrace-sdk/client-query": "^1.26.0",
    "@dynatrace-sdk/client-state": "^1.9.3",
    "@dynatrace-sdk/error-handlers": "^1.3.1",
    "@dynatrace-sdk/http-client": "^1.5.1",
    "@dynatrace-sdk/navigation": "^2.3.0",
    "@dynatrace-sdk/react-hooks": "^1.15.0",
    "@dynatrace/automation-action-components": "^6.6.0",
    "@dynatrace/strato-components": "^3.18.0",
    "@dynatrace/strato-design-tokens": "^1.8.1",
    "@dynatrace/strato-icons": "^2.7.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-is": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@microsoft/eslint-plugin-sdl": "^1.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "dt-app": "1.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@microsoft/eslint-plugin-sdl": {
      "eslint-plugin-n": "$eslint-plugin-n"
    }
  }
}
